# shellcheck shell=bash
# bash can return only from a sourced file; zsh also from a script run on its own, but names sourced files in ZSH_EVAL_CONTEXT
if [ -n "${ZSH_VERSION:-}" ]; then
  [[ "${ZSH_EVAL_CONTEXT:-}" == *:file* ]]
else
  (return 0 2>/dev/null)
fi || {
  echo "Error: the SciRooPlot env script must be sourced." >&2
  exit 1
}
if [ -n "${BASH_VERSION:-}" ]; then
  export SCIROOPLOT_ENV="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
  # shellcheck disable=SC2296
  export SCIROOPLOT_ENV="${(%):-%x}"
else
  echo "Error: unsupported shell, source the SciRooPlot env script from bash or zsh." >&2
  return 1
fi
SCIROOPLOT_DATA_DIR="$(cd -- "$(dirname -- "${SCIROOPLOT_ENV}")" && pwd)"
export SCIROOPLOT_DATA_DIR
SCIROOPLOT_ROOT="$(cd -- "${SCIROOPLOT_DATA_DIR}/../.." && pwd)"
export SCIROOPLOT_ROOT
export SciRooPlot_ROOT="${SCIROOPLOT_ROOT}"  # find_package(SciRooPlot) honours this spelling in every CMake version (the upper-case one only from 3.27)
export SCIROOPLOT_BIN="${SCIROOPLOT_ROOT}/@CMAKE_INSTALL_BINDIR@"
export SCIROOPLOT_LIB="${SCIROOPLOT_ROOT}/@CMAKE_INSTALL_LIBDIR@"
if [[ -d "@PROJECT_SOURCE_DIR@" ]]; then
  export SCIROOPLOT_SOURCE_DIR="@PROJECT_SOURCE_DIR@"
fi
export SCIROOPLOT_PYTHON_EXECUTABLE="@SCIROOPLOT_BINDINGS_PYTHON@"
if [[ -n "${SCIROOPLOT_PYTHON_EXECUTABLE:-}" ]]; then
  export PYTHONPATH="${SCIROOPLOT_ROOT}/@SCIROOPLOT_PYTHONPATH_DIR@${PYTHONPATH:+:${PYTHONPATH}}"
fi

# the modes of plot for tab completion: plot_modes() of src/Validation.h and list
SCIROOPLOT_PLOT_MODES=(show spread print file data list macro pdf eps ps svg png jpg gif html json xml root)

if [[ ! -f "${SCIROOPLOT_BIN}/plot" || ! -f "${SCIROOPLOT_BIN}/srp" ]]; then
  echo "Error: SciRooPlot is not installed. Cannot initialize plotting functions." >&2
  return 1
fi

# the program of a project, whether it is a Python program, and its folder: sets user_program, is_python and user_dir of the caller
_scirooplot_program() {
  # no project selected: empty (under set -e the failing assignment would end the caller)
  user_program=$("${SCIROOPLOT_BIN}/srp" get "${1}" program) || user_program=""
  is_python=0
  [[ "${user_program}" == *.py ]] && is_python=1
  user_dir=""
  [[ -n "${user_program}" ]] && user_dir=$(dirname -- "${user_program}")
  return 0
}

# the installer of the source directory: for an installation into its prefix, for the env.sh of the build directory into the configured one
_scirooplot_install() {
  if [[ -f "${SCIROOPLOT_ROOT}/CMakeCache.txt" ]]; then
    # the installer builds <source>/build only
    if [[ "$(cd -- "${SCIROOPLOT_ROOT}" && pwd -P)" != "$(cd -- "${SCIROOPLOT_SOURCE_DIR}/build" 2>/dev/null && pwd -P)" ]]; then
      echo "Error: ${SCIROOPLOT_ROOT} is not the build directory of the installer (${SCIROOPLOT_SOURCE_DIR}/build): rebuild it with cmake --build ${SCIROOPLOT_ROOT}" >&2
      return 1
    fi
    "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" "${@}"
  else
    "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" --prefix "${SCIROOPLOT_ROOT}" "${@}"
  fi
}

# the Python interpreter SciRooPlot was built with; a source installation whose interpreter is gone is reinstalled
_scirooplot_check_python() {
  if [[ -z "${SCIROOPLOT_PYTHON_EXECUTABLE:-}" ]]; then
    echo "Error: SciRooPlot was not compiled with Python bindings." >&2
    return 1
  fi
  [[ -x "${SCIROOPLOT_PYTHON_EXECUTABLE}" ]] && return 0
  if [[ -z "${SCIROOPLOT_SOURCE_DIR:-}" ]]; then
    echo "Error: SciRooPlot's recorded Python interpreter is missing. Reinstall SciRooPlot to fix this." >&2
    return 1
  fi
  echo "SciRooPlot's Python path is outdated and requires reinstall..."
  _scirooplot_install --reinstall || return 1
  # shellcheck source=/dev/null
  source "${SCIROOPLOT_ENV}"
}

# the bash alias of plot disables globbing for the arguments (bash has no noglob)
_scirooplot_noglob() {
  [[ "${-}" == *f* ]] || SCIROOPLOT_RESTORE_GLOB=1
  set -f
}

# turns globbing back on if it was on before (keeps the exit status for the prompt)
_scirooplot_restore_glob() {
  local exitStatus=$?
  if [[ -n "${SCIROOPLOT_RESTORE_GLOB:-}" ]]; then
    set +f
    unset SCIROOPLOT_RESTORE_GLOB
  fi
  return "${exitStatus}"
}

function plot() {
  _scirooplot_restore_glob
  local user_program is_python user_dir
  _scirooplot_program "@current"
  local missing_program="Warning: program ${user_program} of the current project does not exist (moved or deleted?). Using the stored plot definitions, which may be outdated. To fix it: srp set @current program <path>"
  if [[ -d "${user_dir}" ]]; then
    local user_plotdef
    user_plotdef="$("${SCIROOPLOT_BIN}/srp" confdir "@current")/plots.info"
    (
      cd "${user_dir}" || exit 1
      # rebuild the program if it lives in a CMake build directory (cmake --build also reconfigures if needed);
      # a failed initial configure leaves a CMakeCache.txt without build system, which is configured again first
      if ((!is_python)) && [[ -f "CMakeCache.txt" ]]; then
        err=$({ [[ -f Makefile || -f build.ninja ]] || cmake -Wno-dev .; } 2>&1 && cmake --build . --parallel 2>&1) || {
          echo "${err}" >&2
          exit 1
        }
      fi
      if [[ ! -f "${user_program}" ]]; then
        echo "${missing_program}" >&2
      elif [[ ! -f "${user_plotdef}" || "${user_program}" -nt "${user_plotdef}" ]] ||
        { ((is_python)) && [[ -n "$(find "${user_dir}" -maxdepth 2 -name '*.py' -newer "${user_plotdef}" -print)" ]]; }; then
        if ((is_python)); then
          _scirooplot_check_python || exit 1
          "${SCIROOPLOT_PYTHON_EXECUTABLE}" "${user_program}" || exit 1
        else
          "${user_program}" || exit 1
        fi
        # e.g. a program copied from another project still passes that project's name to the PlotManager
        if [[ ! -f "${user_plotdef}" || "${user_program}" -nt "${user_plotdef}" ]]; then
          echo "Warning: ${user_program} did not save the plot definitions of the current project (does it pass another project name to PlotManager?). Using the stored plot definitions, which may be outdated." >&2
        fi
      fi
    ) || return 1
  elif [[ -n "${user_program}" ]]; then
    echo "${missing_program}" >&2
  fi
  "${SCIROOPLOT_BIN}/plot" "${@}"
}
if [[ -n "${ZSH_VERSION:-}" ]]; then
  alias plot='noglob plot'
elif [[ -n "${BASH_VERSION:-}" ]]; then
  # joined with && so that "a && plot" skips plot when a fails; after ||, !, time or | plot needs braces: a || { plot ...; }
  alias plot='_scirooplot_noglob && plot'
  # plot in a pipeline or in the background restores globbing only in its subshell: the prompt does it in the shell
  [[ "${PROMPT_COMMAND:-}" == *_scirooplot_restore_glob* ]] || PROMPT_COMMAND="_scirooplot_restore_glob${PROMPT_COMMAND:+;${PROMPT_COMMAND}}"
fi

function srp() {
  if [[ "${1:-}" == "update" ]]; then
    # Homebrew: env.sh sourced from <brew>/share, or from $(brew --prefix scirooplot) = <brew>/opt/scirooplot (README), a link into the Cellar
    local brew_prefix="" brew_formula=""
    if command -v brew >/dev/null 2>&1; then
      brew_prefix=$(brew --prefix)
      brew_formula=$(cd -- "$(brew --prefix scirooplot)" 2>/dev/null && pwd -P)
    fi
    if [[ -n "${brew_prefix}" ]] && [[ "${SCIROOPLOT_ROOT}" == "${brew_prefix}" || "$(cd -- "${SCIROOPLOT_ROOT}" && pwd -P)" == "${brew_formula}" ]]; then
      brew upgrade scirooplot || return 1
    # compared as physical paths: CONDA_PREFIX may end with a slash or go through a link
    elif [[ -n "${CONDA_PREFIX:-}" ]] && [[ "$(cd -- "${SCIROOPLOT_ROOT}" && pwd -P)" == "$(cd -- "${CONDA_PREFIX}" 2>/dev/null && pwd -P)" ]]; then
      # pixi owns its environments: changing them directly is undone by the next pixi install
      if [[ -n "${PIXI_PROJECT_MANIFEST:-}" ]]; then
        echo "Error: pixi environment, update with: pixi upgrade scirooplot (in ${PIXI_PROJECT_ROOT:-the pixi project})" >&2
        return 1
      fi
      local tool="" t
      # the tool that owns the environment: micromamba keeps its environments under MAMBA_ROOT_PREFIX
      if [[ -n "${MAMBA_ROOT_PREFIX:-}" && "${CONDA_PREFIX}/" == "${MAMBA_ROOT_PREFIX%/}/"* ]] && command -v micromamba >/dev/null 2>&1; then
        tool=micromamba
      else
        for t in conda mamba micromamba; do
          command -v "${t}" >/dev/null 2>&1 && { tool="${t}"; break; }
        done
      fi
      if [[ -z "${tool}" ]]; then
        echo "Error: neither conda, mamba nor micromamba found to update ${CONDA_PREFIX}" >&2
        return 1
      fi
      # update takes names only, no channel::name
      "${tool}" update -p "${CONDA_PREFIX}" -c conda-forge scirooplot || return 1
    else
      if [[ -z "${SCIROOPLOT_SOURCE_DIR:-}" || ! -d "${SCIROOPLOT_SOURCE_DIR}" ]]; then
        echo "Error: SciRooPlot source directory not found." >&2
        echo "  SCIROOPLOT_SOURCE_DIR=${SCIROOPLOT_SOURCE_DIR:-<unset>}" >&2
        return 1
      fi
      if [[ ! -f "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" ]]; then
        echo "Error: SciRooPlot installer not found:" >&2
        echo "  ${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" >&2
        return 1
      fi
      # into the running installation (without the prefix, a fresh build directory would install into <source>/install)
      if [[ -n "${2:-}" ]]; then
        _scirooplot_install "${2}" || return 1
      else
        _scirooplot_install || return 1
      fi
    fi
    # shellcheck source=/dev/null
    source "${SCIROOPLOT_ENV}"
    return 0
  elif [[ "${1:-}" == "cd" || "${1:-}" == "edit" || "${1:-}" == "out" ]]; then
    local project_name="${2:-@current}"
    local opener
    # open on macOS only: on Linux it is often openvt
    if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
      opener=(open)
    elif command -v xdg-open >/dev/null 2>&1; then
      opener=(xdg-open)
    elif command -v gio >/dev/null 2>&1; then
      opener=(gio open)
    elif command -v wslview >/dev/null 2>&1; then
      opener=(wslview)
    fi
    if [[ "${1:-}" == "out" ]]; then
      local out_dir
      if ! out_dir=$("${SCIROOPLOT_BIN}/srp" "get" "${project_name}" "outdir"); then
        echo "Error: could not open the output folder of project '${project_name}'." >&2
        return 1
      fi
      if [[ -z "${out_dir}" ]]; then
        echo "Error: project '${project_name}' has no output folder (srp set ${project_name} outdir <folder>)." >&2
        return 1
      fi
      if [[ ! -d "${out_dir}" ]]; then
        echo "Error: output folder ${out_dir} does not exist yet (it is created when plots are saved to files)." >&2
        return 1
      fi
      if [[ -z "${opener:-}" ]]; then
        echo "Error: no program found to open folders (open, xdg-open, gio, wslview). The output folder is ${out_dir}" >&2
        return 1
      fi
      "${opener[@]}" "${out_dir}"
      return
    fi
    local user_program is_python user_dir
    _scirooplot_program "${project_name}"
    if [[ -d "${user_dir}" ]]; then
      if [[ "${1:-}" == "cd" ]]; then
        cd "${user_dir}" || return 1
        return 0
      elif [[ "${1:-}" == "edit" ]]; then
        if [[ -n "${opener:-}" ]]; then
          if command -v find >/dev/null 2>&1; then
            # xdg-open and wslview open one file per call
            local files=() file
            if ((is_python)); then
              while IFS= read -r -d '' file; do files+=("${file}"); done < <(find "${user_dir}/" -maxdepth 2 -type f \( -name '*.py' \) -print0)
            else
              while IFS= read -r -d '' file; do files+=("${file}"); done < <(find "${user_dir}/.." -maxdepth 2 -type f \( -name '*.cxx' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \) -print0)
            fi
            if [[ "${opener[*]}" == "xdg-open" || "${opener[*]}" == "wslview" ]]; then
              for file in "${files[@]}"; do
                "${opener[@]}" "${file}" || return 1
              done
            elif ((${#files[@]})); then
              "${opener[@]}" "${files[@]}" || return 1
            fi
            return 0
          fi
        fi
      fi
    fi
    echo "Error: could not ${1:-} project '${project_name}'." >&2
    return 1
  elif [[ "${1:-}" =~ ^(init|example)-(cpp|py)$ ]]; then
    # init-* starts from a minimal skeleton, example-* from the commented examples
    local init_command="${1:-}"
    local is_python=0
    [[ "${init_command}" == *-py ]] && is_python=1
    local template_dir="${SCIROOPLOT_DATA_DIR}/templates/skeleton"
    [[ "${init_command}" == example-* ]] && template_dir="${SCIROOPLOT_DATA_DIR}/templates/example"
    local project_name="${2:-}"
    local project_path="${project_name}"
    [[ -n "${3:-}" ]] && project_path="${3:-}"
    if [[ "${project_path}" != /* ]]; then
      project_path="$(pwd)/${project_path}"
    fi
    if [[ -z "${project_name}" ]]; then
      echo "Error: No project name specified. Doing nothing..." >&2
      return 1
    fi
    if [[ "${project_name}" == "@current" ]]; then
      echo "Error: A project cannot be called @current." >&2
      return 1
    fi
    if "${SCIROOPLOT_BIN}/srp" projects "${project_name}" >/dev/null 2>&1; then
      echo "Error: Project ${project_name} already exists. Doing nothing..." >&2
      return 1
    fi
    if [[ -d "${project_path}" ]]; then
      echo "Error: Folder ${project_path} already exists. Doing nothing..." >&2
      return 1
    fi
    # register the project first: srp add checks the name before anything is created,
    # and after a failing build or run plot can be used to retry
    local program="${project_path}/build/definePlots"
    ((is_python)) && program="${project_path}/DefinePlots.py"
    "${SCIROOPLOT_BIN}/srp" "add" "${project_name}" "${program}" "${project_path}/output" || return 1

    mkdir -p "${project_path}"
    if ((is_python)); then
      cp "${template_dir}/DefinePlots.py" "${project_path}/"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/DefinePlots.py" && rm -f "${project_path}/DefinePlots.py.bak"
      _scirooplot_check_python || return 1
      if ! "${SCIROOPLOT_PYTHON_EXECUTABLE}" "${project_path}/DefinePlots.py"; then
        echo "Error: Failed to run ${project_path}/DefinePlots.py. Project ${project_name} is set up nevertheless: fix the errors above and run plot to retry." >&2
        return 1
      fi
    else
      cp "${SCIROOPLOT_DATA_DIR}/templates/CMakeLists.txt" "${project_path}/"
      cp "${template_dir}/DefinePlots.cpp" "${project_path}/"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/CMakeLists.txt" && rm -f "${project_path}/CMakeLists.txt.bak"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/DefinePlots.cpp" && rm -f "${project_path}/DefinePlots.cpp.bak"
      mkdir -p "${project_path}/build"
      local build_log
      if ! build_log=$(cd "${project_path}/build" && cmake -Wno-dev .. 2>&1 && cmake --build . --parallel 2>&1); then
        echo "${build_log}" >&2
        echo "Error: Failed to configure or build ${project_path}. Project ${project_name} is set up nevertheless: fix the errors above and run plot to retry." >&2
        return 1
      fi
      if ! (cd "${project_path}/build" && ./definePlots); then
        echo "Error: Failed to run ${project_path}/build/definePlots. Project ${project_name} is set up nevertheless: fix the errors above and run plot to retry." >&2
        return 1
      fi
    fi
    "${SCIROOPLOT_BIN}/srp" projects "${project_name}"
  else
    local args=("${@}")
    [[ -n "${ZSH_VERSION:-}" ]] && setopt local_options KSH_ARRAYS
    # relative paths are made absolute here; absolute ones and those starting with ~ or a variable are expanded by srp itself
    local is_relative='^[^/~$]'
    if ((${#args[@]} >= 4)) && [[ "${args[2]}" =~ ^(program|outdir)$ ]] && [[ "${args[3]}" =~ ${is_relative} ]]; then
      args[3]="$(pwd)/${args[3]}"
    fi
    if ((${#args[@]} >= 1)) && [[ "${args[0]}" =~ ^(add)$ ]]; then
      if ((${#args[@]} >= 3)) && [[ "${args[2]}" =~ ${is_relative} ]]; then
        args[2]="$(pwd)/${args[2]}"
      fi
      if ((${#args[@]} >= 4)) && [[ "${args[3]}" =~ ${is_relative} ]]; then
        args[3]="$(pwd)/${args[3]}"
      fi
    fi
    "${SCIROOPLOT_BIN}/srp" "${args[@]}"
  fi
}

# enable tab completion only for interactive shells
case "${-}" in
  *i*) ;;
  *) return 0 ;;
esac

_scirooplot_helper() {
  case "${1}" in
    load_plot_lists)
      modes=("${SCIROOPLOT_PLOT_MODES[@]}")
      main_groups=()
      groups=()

      _scirooplot_helper load_config
      [[ -n "${current_project}" ]] || return 1
      tabcomp_file="${config_dir}/${current_project}/tabcomp.csv"
      [[ -f "${tabcomp_file}" ]] || return 1

      # unique groups via awk: a shell loop over all plots is slow for large projects
      local group_in
      while IFS= read -r group_in; do
        groups+=("${group_in}")
      done < <(LC_ALL=C awk '{ group = substr($0, index($0, ",") + 1) } !seen[group]++ { print group }' "${tabcomp_file}" | LC_ALL=C sort)
      while IFS= read -r group_in; do
        main_groups+=("${group_in}")
      done < <(printf '%s\n' "${groups[@]}" | LC_ALL=C awk -F'/' '!seen[$1]++ { print $1 }')

      _scirooplot_helper load_match_settings
      ;;
    load_config)
      # same as Config::LoadConfig, avoiding to start the srp binary on every Tab
      config_dir="${SCIROOPLOT_CONFIG_PATH:-${HOME}/.SciRooPlot}"
      [[ "${config_dir}" == \~ || "${config_dir}" == \~/* ]] && config_dir="${HOME}${config_dir:1}"  # a ~ the shell did not expand
      current_project=""
      if [[ -f "${config_dir}/projects.info" ]]; then
        local key value
        while read -r key value; do
          [[ "${key}" == "@current" ]] && current_project="${value}"
        done < "${config_dir}/projects.info"
      fi
      return 0
      ;;
    load_match_settings)
      # the matchmode and matchcase settings plot itself uses
      match_contains=0
      match_case_insensitive=0
      local settings_file
      settings_file="${config_dir}/settings.info"
      if [[ -f "${settings_file}" ]]; then
        local setting_key setting_val
        while read -r setting_key setting_val; do
          case "${setting_key}" in
            matchmode) [[ "${setting_val}" == "contains" ]] && match_contains=1 ;;
            matchcase) [[ "${setting_val}" == "insensitive" ]] && match_case_insensitive=1 ;;
          esac
        done < "${settings_file}"
      fi
      # return 0: a false test above must not abort load_plot_lists (|| return)
      return 0
      ;;
    update_plot_names)
      # subgroups included, as in RegexMatcher::WithSubpaths
      local group="${2:-}"
      group="${group#[\"\']}"
      group="${group%[\"\']}"
      # a trailing slash ends the group name, as in PlotManager::PlotMatcher
      local ends_here=0
      while [[ "${group}" == ?*/ && "${group}" != *\\/ ]]; do
        group="${group%/}"
        ends_here=1
      done
      local posix_pattern
      _scirooplot_helper posix_regex "${group}"
      local group_pattern="(${posix_pattern})(/.*)?"
      # contains mode must not take group/ for groupx
      ((ends_here && match_contains)) && group_pattern="(${posix_pattern})(/|\$)"
      # the group is complete here (space typed): exact mode needs a full match like plot, not the start
      ((match_contains)) || group_pattern="^${group_pattern}\$"
      names=()

      # match only the unique groups here, then let awk collect the plot names of the matching groups
      local -a matched_groups filtered
      _scirooplot_helper regex_filter "${group_pattern}" "${groups[@]}"
      matched_groups=("${filtered[@]}")
      local name_in
      if ((${#matched_groups[@]})); then
        while IFS= read -r name_in; do
          names+=("${name_in}")
        done < <(printf '%s\n' "${matched_groups[@]}" | LC_ALL=C awk 'NR == FNR { wanted[$0]; next }
          { i = index($0, ","); name = substr($0, 1, i - 1) } (substr($0, i + 1) in wanted) && !seen[name]++ { print name }' - "${tabcomp_file}")
      fi
      # return 0: see load_match_settings
      return 0
      ;;
    posix_regex)
      # plot matches with std::regex (ECMAScript), the shell with POSIX ERE: translate \d \w \s and their negations
      local src="${2:-}" c next
      local -i i=0 in_bracket=0
      posix_pattern=""
      while ((i < ${#src})); do
        c="${src:$i:1}"
        next="${src:$((i + 1)):1}"
        if [[ "${c}" == "\\" && -n "${next}" ]]; then
          case "${in_bracket}${next}" in
            0d) posix_pattern+="[[:digit:]]" ;;
            0D) posix_pattern+="[^[:digit:]]" ;;
            0w) posix_pattern+="[[:alnum:]_]" ;;
            0W) posix_pattern+="[^[:alnum:]_]" ;;
            0s) posix_pattern+="[[:space:]]" ;;
            0S) posix_pattern+="[^[:space:]]" ;;
            1d) posix_pattern+="[:digit:]" ;;
            1w) posix_pattern+="[:alnum:]_" ;;
            1s) posix_pattern+="[:space:]" ;;
            *) posix_pattern+="${c}${next}" ;;
          esac
          ((i += 2))
          continue
        fi
        if ((in_bracket)); then
          # [:class:] is copied as a whole
          if [[ "${c}" == "]" ]]; then
            in_bracket=0
          elif [[ "${c}${next}" == "[:" && "${src:$i}" == *":]"* ]]; then
            local class="${src:$i}"
            class="${class%%:]*}:]"
            posix_pattern+="${class}"
            ((i += ${#class}))
            continue
          fi
        elif [[ "${c}" == "[" ]]; then
          # a ] right after [ or [^ is a literal
          in_bracket=1
          posix_pattern+="${c}"
          ((i += 1))
          [[ "${src:$i:1}" == "^" ]] && posix_pattern+="^" && ((i += 1))
          [[ "${src:$i:1}" == "]" ]] && posix_pattern+="]" && ((i += 1))
          continue
        fi
        posix_pattern+="${c}"
        ((i += 1))
      done
      return 0
      ;;
    filter_names_regex)
      # without the quotes the shell keeps in COMP_WORDS/words
      local pattern="${2:-}"
      pattern="${pattern#[\"\']}"
      pattern="${pattern%[\"\']}"
      # for should_offer_completion
      stripped_pattern="${pattern}"
      matches=()

      # an empty word shows everything (anchored as ^$ it would match nothing)
      if [[ -z "${pattern}" ]]; then
        matches=("${names[@]}")
        return 0
      fi

      local posix_pattern
      _scirooplot_helper posix_regex "${pattern}"
      local test_pattern="${posix_pattern}"
      # exact mode matches the start while typing, so h still matches hist_a
      ((match_contains)) || test_pattern="^${posix_pattern}"

      local -a filtered
      _scirooplot_helper regex_filter "${test_pattern}" "${names[@]}"
      matches=("${filtered[@]}")
      return 0
      ;;
    regex_filter)
      # the items matching the (POSIX) pattern into filtered, ignoring case in matchcase insensitive
      local filter_pattern="${2:-}" item had_nocasematch=0 had_case_match=1
      shift 2
      filtered=()
      if ((match_case_insensitive)); then
        if [[ -n "${BASH_VERSION:-}" ]]; then
          shopt -q nocasematch && had_nocasematch=1
          shopt -s nocasematch
        elif [[ -n "${ZSH_VERSION:-}" ]]; then
          [[ -o CASE_MATCH ]] || had_case_match=0
          unsetopt CASE_MATCH
        fi
      fi
      for item in "$@"; do
        [[ "${item}" =~ ${filter_pattern} ]] 2>/dev/null && filtered+=("${item}")
      done
      if ((match_case_insensitive)); then
        if [[ -n "${BASH_VERSION:-}" ]]; then
          ((had_nocasematch)) || shopt -u nocasematch
        elif [[ -n "${ZSH_VERSION:-}" ]]; then
          ((had_case_match)) && setopt CASE_MATCH
        fi
      fi
      return 0
      ;;
    should_offer_completion)
      # inserted only if every match starts with what was typed: otherwise a regex like .+Ge
      # could be replaced by an unrelated shorter prefix (e.g. pp_)
      offer_completion=1
      if ((${#matches[@]} > 1)); then
        local m
        for m in "${matches[@]}"; do
          if [[ "${m}" != "${stripped_pattern}"* ]]; then
            offer_completion=0
            break
          fi
        done
      fi
      return 0
      ;;
    load_srp_lists)
      general_commands=(info update init-cpp init-py example-cpp example-py add clean reset help settings color verbosity plotmode matchmode matchcase screenscale bitmapscale)
      project_commands=(projects cd edit out remove rename select confdir set unset get)
      project_commands_with_prop=(set unset get)
      properties=(program outdir)
      file_commands=(open print colorwheel)
      color_settings=(bright dark off)
      verbosity_settings=(debug log info warning error silent)
      plotmodes=("${SCIROOPLOT_PLOT_MODES[@]}")
      matchmode_settings=(exact contains)
      matchcase_settings=(sensitive insensitive)

      projects=()
      _scirooplot_helper load_config
      local project_file="${config_dir}/projects.info"
      if [[ -f "${project_file}" ]]; then
        projects=("@current")
        local project
        while read -r project; do
          projects+=("${project}")
        done < <(awk 'prev != "" && $0 == "{" { print prev } { prev = ($0 ~ /^[^ \t]/) ? $0 : "" }' "${project_file}")  # unindented lines followed by a line "{" (property values can contain braces)
      fi
      ;;
    contains)
      local needle="${2:-}"
      shift 2
      local item
      for item in "${@}"; do
        [[ "${item}" == "${needle}" ]] && return 0
      done
      return 1
      ;;
  esac
}

_scirooplot_should_offer_completion() {
  _scirooplot_helper should_offer_completion
  ((offer_completion))
}

# shellcheck disable=SC2034,SC2154
_scirooplot_show_matches_without_inserting() {
  # lists the matches without letting zsh insert their common prefix over the typed regex
  compadd -U -a matches
  compstate[insert]=''
}

_scirooplot_offer_matches() {
  # completes if safe, otherwise lists the matches without touching the typed text
  if _scirooplot_should_offer_completion; then
    compadd -U -a matches
  else
    _scirooplot_show_matches_without_inserting
  fi
}

# shellcheck disable=SC2016,SC2154
_plot_completions_zsh() {

  local modes main_groups groups names matches tabcomp_file match_contains match_case_insensitive stripped_pattern offer_completion
  local config_dir current_project
  _scirooplot_helper load_plot_lists || return

  _arguments \
    '1: :->group' \
    '2: :->name' \
    '3: :->mode'

  case "${state}" in
    group)
      if [[ "${words[2]}" == *"/"* ]]; then
        names=("${groups[@]}")
      else
        names=("${main_groups[@]}")
      fi
      _scirooplot_helper filter_names_regex "${words[2]}"
      # -U: no literal prefix filter of zsh, the matches are filtered by the regex already
      _scirooplot_offer_matches
      ;;
    name)
      _scirooplot_helper update_plot_names "${words[2]}"
      _scirooplot_helper filter_names_regex "${words[3]}"
      _scirooplot_offer_matches
      ;;
    mode)
      _arguments '3:mode:(${modes[*]})'
      ;;
  esac
}

# shellcheck disable=SC2016,SC2154
_srp_completions_zsh() {

  local general_commands project_commands project_commands_with_prop properties
  local file_commands color_settings verbosity_settings plotmodes
  local matchmode_settings matchcase_settings projects config_dir current_project
  _scirooplot_helper load_srp_lists

  _arguments \
    '1: :->command' \
    '2: :->project' \
    '3: :->property' \
    '4: :->setting'

  case "${state}" in
    command)
      _arguments '1:command:(${general_commands[*]} ${project_commands[*]} ${file_commands[*]})'
      ;;
    project)
      if _scirooplot_helper contains "${words[2]}" "${project_commands[@]}"; then
        _arguments '2:project:(${projects[*]})'
      elif [[ "${words[2]}" == "colorwheel" ]]; then
        _files  # the image to write
      elif _scirooplot_helper contains "${words[2]}" "${file_commands[@]}"; then
        _files -g '*.root'
      elif [[ "${words[2]}" == "color" ]]; then
        _arguments '2:color:(${color_settings[*]})'
      elif [[ "${words[2]}" == "verbosity" ]]; then
        _arguments '2:verbosity:(${verbosity_settings[*]})'
      elif [[ "${words[2]}" == "plotmode" ]]; then
        _arguments '2:plot mode:(${plotmodes[*]})'
      elif [[ "${words[2]}" == "matchmode" ]]; then
        _arguments '2:match mode:(${matchmode_settings[*]})'
      elif [[ "${words[2]}" == "matchcase" ]]; then
        _arguments '2:match case:(${matchcase_settings[*]})'
      fi
      ;;
    property)
      if _scirooplot_helper contains "${words[2]}" "${project_commands_with_prop[@]}"; then
        _arguments '3:property:(${properties[*]})'
      elif [[ "${words[2]}" == init-* || "${words[2]}" == example-* ]]; then
        _files -/
      elif [[ "${words[2]}" == "add" ]]; then
        _files -f
      fi
      ;;
    setting)
      if [[ "${words[2]}" == "add" ]]; then
        _files -/
      elif [[ "${words[2]}" == "set" ]]; then
        if [[ "${words[4]}" == "program" ]]; then
          _files -f
        elif [[ "${words[4]}" == "outdir" ]]; then
          _files -/
        fi
      fi
      ;;
  esac
}

# shellcheck disable=SC2207
_plot_completions_bash() {

  local modes main_groups groups names matches tabcomp_file match_contains match_case_insensitive stripped_pattern offer_completion
  local config_dir current_project
  _scirooplot_helper load_plot_lists || return

  case "${COMP_CWORD}" in
    1)
      if [[ "${COMP_WORDS[COMP_CWORD]}" == *"/"* ]]; then
        names=("${groups[@]}")
      else
        names=("${main_groups[@]}")
      fi
      _scirooplot_helper filter_names_regex "${COMP_WORDS[COMP_CWORD]}"
      _scirooplot_helper should_offer_completion
      # an empty COMPREPLY would make bash complete file names: give back the typed word when ambiguous
      if ((offer_completion)); then
        COMPREPLY=($(compgen -W "${matches[*]}" -- ""))
      else
        COMPREPLY=("${COMP_WORDS[COMP_CWORD]}")
      fi
      ;;
    2)
      _scirooplot_helper update_plot_names "${COMP_WORDS[COMP_CWORD - 1]}"
      _scirooplot_helper filter_names_regex "${COMP_WORDS[COMP_CWORD]}"
      _scirooplot_helper should_offer_completion
      if ((offer_completion)); then
        COMPREPLY=($(compgen -W "${matches[*]}" -- ""))
      else
        COMPREPLY=("${COMP_WORDS[COMP_CWORD]}")
      fi
      ;;
    3)
      COMPREPLY=($(compgen -W "${modes[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      ;;
  esac
}

# files (-f) or folders (-d) completing the current word, names with spaces kept whole and escaped by readline
_scirooplot_complete_paths() {
  local name
  COMPREPLY=()
  compopt -o filenames 2>/dev/null
  while IFS= read -r name; do
    COMPREPLY+=("${name}")
  done < <(compgen "${1}" -- "${COMP_WORDS[COMP_CWORD]}")
}

# shellcheck disable=SC2207
_srp_completions_bash() {

  local general_commands project_commands project_commands_with_prop properties
  local file_commands color_settings verbosity_settings plotmodes
  local matchmode_settings matchcase_settings projects config_dir current_project
  _scirooplot_helper load_srp_lists

  case "${COMP_CWORD}" in
    1)
      COMPREPLY=($(compgen -W "${general_commands[*]} ${project_commands[*]} ${file_commands[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      ;;
    2)
      if _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 1]}" "${project_commands[@]}"; then
        COMPREPLY=($(compgen -W "${projects[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 1]}" "${file_commands[@]}"; then
        local cur="${COMP_WORDS[COMP_CWORD]}"
        local d f
        compopt -o filenames 2>/dev/null  # escapes spaces in the names
        while IFS= read -r d; do
          COMPREPLY+=("${d}/")
        done < <(compgen -d -- "${cur}")
        while IFS= read -r f; do
          # colorwheel writes an image: any name
          [[ -d "${f}" ]] && continue  # already offered with / above
          [[ "${f}" == *.root || "${COMP_WORDS[COMP_CWORD - 1]}" == "colorwheel" ]] && COMPREPLY+=("${f}")
        done < <(compgen -f -- "${cur}")
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "color" ]]; then
        COMPREPLY=($(compgen -W "${color_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "verbosity" ]]; then
        COMPREPLY=($(compgen -W "${verbosity_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "plotmode" ]]; then
        COMPREPLY=($(compgen -W "${plotmodes[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "matchmode" ]]; then
        COMPREPLY=($(compgen -W "${matchmode_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "matchcase" ]]; then
        COMPREPLY=($(compgen -W "${matchcase_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      else
        COMPREPLY=()
      fi
      ;;
    3)
      if _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 2]}" "${project_commands_with_prop[@]}"; then
        COMPREPLY=($(compgen -W "${properties[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 2]}" == init-* || "${COMP_WORDS[COMP_CWORD - 2]}" == example-* ]]; then
        _scirooplot_complete_paths -d
      elif [[ "${COMP_WORDS[COMP_CWORD - 2]}" == "add" ]]; then
        _scirooplot_complete_paths -f
      else
        COMPREPLY=()
      fi
      ;;
    4)
      if [[ "${COMP_WORDS[COMP_CWORD - 3]}" == "add" ]]; then
        _scirooplot_complete_paths -d
      elif [[ "${COMP_WORDS[COMP_CWORD - 3]}" == "set" ]]; then
        case "${COMP_WORDS[COMP_CWORD - 1]}" in
          program)
            _scirooplot_complete_paths -f
            ;;
          outdir)
            _scirooplot_complete_paths -d
            ;;
        esac
      fi
      ;;
  esac
}

if [[ -n "${ZSH_VERSION:-}" ]]; then
  if ! command -v compinit &>/dev/null; then
    autoload -U compinit compdef
    # without a terminal compinit cannot ask about insecure directories and aborts with an error: it skips them instead
    if [[ -n "${TTY:-}" ]]; then compinit; else compinit -i; fi
  fi
  _scirooplot_register_completions() {
    if command -v compdef &>/dev/null; then
      compdef _plot_completions_zsh plot
      compdef _srp_completions_zsh srp
    fi
  }
  _scirooplot_register_completions
  # a compinit later in .zshrc (frameworks run their own) drops the registration: done again before the first prompt
  _scirooplot_first_prompt() {
    _scirooplot_register_completions
    # shellcheck disable=SC2296
    precmd_functions=("${(@)precmd_functions:#_scirooplot_first_prompt}")
  }
  [[ -o interactive ]] && precmd_functions+=(_scirooplot_first_prompt)
  # the default Tab (expand-or-complete) expands globs before completing (.* becomes files): arguments of plot
  # and srp go through plain completion instead, if Tab is still bound to that default
  if [[ "$(bindkey '^I' 2>/dev/null)" == *expand-or-complete* ]]; then
    _scirooplot_tab_widget() {
      case "${LBUFFER}" in
        plot\ *|srp\ *) zle complete-word ;;
        *) zle expand-or-complete ;;
      esac
    }
    zle -N _scirooplot_tab_widget
    bindkey '^I' _scirooplot_tab_widget
  fi
elif [[ -n "${BASH_VERSION:-}" ]]; then
  if ! shopt -q progcomp; then
    BASH_COMPLETION_PATHS=(
      "/usr/share/bash-completion/bash_completion"
      "/etc/bash_completion"
      "/usr/local/etc/bash_completion"
      "/opt/homebrew/etc/bash_completion"
    )
    for bc in "${BASH_COMPLETION_PATHS[@]}"; do
      if [[ -r "${bc}" ]]; then
        # shellcheck source=/dev/null
        source "${bc}"
        shopt -q progcomp && break
      fi
    done
  fi
  if shopt -q progcomp; then
    complete -F _plot_completions_bash plot
    complete -F _srp_completions_bash srp
  fi
fi
