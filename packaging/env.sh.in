# shellcheck shell=bash
(return 0 2>/dev/null) || {
  echo "The SciRooPlot env script must be sourced."
  exit 1
}
if [ -n "${BASH_VERSION:-}" ]; then
  export SCIROOPLOT_ENV="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
  # shellcheck disable=SC2296
  export SCIROOPLOT_ENV="${(%):-%x}"
else
  echo "Error: Unsupported shell. Please source SciRooPlot env script from bash or zsh."
  return 1
fi
SCIROOPLOT_DATA_DIR="$(cd -- "$(dirname -- "${SCIROOPLOT_ENV}")" && pwd)"
export SCIROOPLOT_DATA_DIR
SCIROOPLOT_ROOT="$(cd -- "${SCIROOPLOT_DATA_DIR}/../.." && pwd)"
export SCIROOPLOT_ROOT
export SCIROOPLOT_BIN="${SCIROOPLOT_ROOT}/@CMAKE_INSTALL_BINDIR@"
export SCIROOPLOT_LIB="${SCIROOPLOT_ROOT}/@CMAKE_INSTALL_LIBDIR@"
if [[ -d "@CMAKE_CURRENT_BINARY_DIR@/.." ]]; then
  export SCIROOPLOT_SOURCE_DIR="@CMAKE_CURRENT_BINARY_DIR@/.."
fi
export SCIROOPLOT_PYTHON_EXECUTABLE="@Python3_EXECUTABLE@"
if [[ -n "${SCIROOPLOT_PYTHON_EXECUTABLE:-}" ]]; then
  export PYTHONPATH="${SCIROOPLOT_ROOT}/@SCIROOPLOT_PYTHONPATH_DIR@${PYTHONPATH:+:${PYTHONPATH}}"
fi

if [[ ! -f "${SCIROOPLOT_BIN}/plot" || ! -f "${SCIROOPLOT_BIN}/srp" ]]; then
  echo "Error: SciRooPlot is not installed. Cannot initialize plotting functions."
  return 1
fi

function plot() {
  [[ -n "${BASH_VERSION:-}" ]] && set +f
  local user_program
  user_program=$("${SCIROOPLOT_BIN}/srp" "get" "@current" "program")
  local is_python=0
  [[ "${user_program}" == *.py ]] && is_python=1
  local user_dir
  user_dir=$([[ -n "${user_program}" ]] && dirname -- "${user_program}" || echo "")
  if [[ -d "${user_dir}" ]]; then
    local user_plotdef
    user_plotdef="$("${SCIROOPLOT_BIN}/srp" confdir "@current")/plots.info"
    (
      cd "${user_dir}"
      if ((!is_python)); then
        err=$(cmake -S .. -B . 2>&1 >/dev/null) || {
          echo "${err}"
          exit 1
        }
        (cmake --build . -j6 >/dev/null) || exit 1
      fi
      if [[ ! -f "${user_plotdef}" || "${user_program}" -nt "${user_plotdef}" ]]; then
        if ((is_python)); then
          if [[ -n "${SCIROOPLOT_PYTHON_EXECUTABLE:-}" ]]; then
            if [[ ! -x "${SCIROOPLOT_PYTHON_EXECUTABLE}" ]]; then
              if [[ -n "${SCIROOPLOT_SOURCE_DIR:-}" ]]; then
                echo "SciRooPlot's Python path is outdated and requires reinstall..."
                "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" --reinstall || exit 1
                # shellcheck source=/dev/null
                source "${SCIROOPLOT_ENV}"
              else
                echo "Error: SciRooPlot's recorded Python interpreter is missing. Reinstall SciRooPlot to fix this."
                exit 1
              fi
            fi
            ${SCIROOPLOT_PYTHON_EXECUTABLE} "${user_program}"
          else
            echo "Error: SciRooPlot was not compiled with Python bindings."
          fi
        else
          "${user_program}"
        fi
      fi
    ) || return 1
  fi
  "${SCIROOPLOT_BIN}/plot" "${@}"
  return 0
}
if [[ -n "${ZSH_VERSION:-}" ]]; then
  alias plot='noglob plot'
elif [[ -n "${BASH_VERSION:-}" ]]; then
  alias plot='set -f; plot'
fi

function srp() {
  if [[ "${1:-}" == "update" ]]; then
    if command -v brew >/dev/null 2>&1 && [[ "${SCIROOPLOT_ROOT}" == "$(brew --prefix)" ]]; then
      brew upgrade scirooplot
    elif [[ -n "${CONDA_PREFIX:-}" ]] && [[ "${SCIROOPLOT_ROOT}" == "${CONDA_PREFIX}" ]]; then
      conda update conda-forge::scirooplot
    else
      if [[ -z "${SCIROOPLOT_SOURCE_DIR:-}" || ! -d "${SCIROOPLOT_SOURCE_DIR}" ]]; then
        echo "Error: SciRooPlot source directory not found."
        echo "  SCIROOPLOT_SOURCE_DIR=${SCIROOPLOT_SOURCE_DIR:-<unset>}"
        return 1
      fi
      if [[ ! -f "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" ]]; then
        echo "Error: SciRooPlot installer not found:"
        echo "  ${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh"
        return 1
      fi
      if [[ -n "${2:-}" ]]; then
        "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" "${2}"
      else
        "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh"
      fi
    fi
    # shellcheck source=/dev/null
    source "${SCIROOPLOT_ENV}"
  elif [[ "${1:-}" == "cd" || "${1:-}" == "edit" ]]; then
    local project_name="${2:-}"
    local user_program
    user_program=$("${SCIROOPLOT_BIN}/srp" "get" "${project_name}" "program")
    local is_python=0
    [[ "${user_program}" == *.py ]] && is_python=1
    local user_dir
    user_dir=$([[ -n "${user_program}" ]] && dirname -- "${user_program}" || echo "")
    if [[ -d "${user_dir}" ]]; then
      if [[ "${1:-}" == "cd" ]]; then
        cd "${user_dir}" || return 1
        return 0
      elif [[ "${1:-}" == "edit" ]]; then
        local opener
        if command -v open >/dev/null 2>&1; then
          opener=(open)
        elif command -v xdg-open >/dev/null 2>&1; then
          opener=(xdg-open)
        elif command -v gio >/dev/null 2>&1; then
          opener=(gio open)
        elif command -v wslview >/dev/null 2>&1; then
          opener=(wslview)
        fi
        if [[ -n "${opener:-}" ]]; then
          if command -v find >/dev/null 2>&1; then
            if ((is_python)); then
              find "${user_dir}/" -maxdepth 2 -type f \( -name '*.py' \) -exec "${opener[@]}" {} +
            else
              find "${user_dir}/.." -maxdepth 2 -type f \( -name '*.cxx' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \) -exec "${opener[@]}" {} +
            fi
            return 0
          fi
        fi
      fi
    fi
  elif [[ "${1:-}" == "stats" ]]; then
    local project_name="${2:-}"
    if [[ -z "${project_name}" ]]; then
      echo "Error: No project name specified. Doing nothing..."
      return 1
    fi
    local project_confdir
    project_confdir="$("${SCIROOPLOT_BIN}/srp" confdir "${project_name}")"
    local n_plots=0
    local n_inputs=0
    local last_modified="-"
    local tabcomp_file
    tabcomp_file="${project_confdir}/tabcomp.csv"
    if [[ -f "${tabcomp_file}" ]]; then
      n_plots=$(wc -l <"${tabcomp_file}")
      if [[ "${OSTYPE}" == darwin* ]]; then
        last_modified=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "${tabcomp_file}")
      else
        last_modified=$(stat -c "%y" "${tabcomp_file}" | cut -d'.' -f1)
      fi
    fi
    local datasources_file="${project_confdir}/dataSources.info"
    if [[ -f "${datasources_file}" ]]; then
      n_inputs=$(grep -c 'FILE' "${datasources_file}")
    fi
    printf "Plots          : %d\n" "${n_plots}"
    printf "Input files    : %d\n" "${n_inputs}"
    printf "Last modified  : %s\n" "${last_modified}"
  elif [[ "${1:-}" == "init-cpp" || "${1:-}" == "init-py" ]]; then
    local is_python=0
    [[ "${1:-}" == "init-py" ]] && is_python=1
    local project_name="${2:-}"
    local project_path="${project_name}"
    [[ -n "${3:-}" ]] && project_path="${3:-}"
    if [[ "${project_path}" != /* ]]; then
      project_path="$(pwd)/${project_path}"
    fi
    if [[ -z "${project_name}" ]]; then
      echo "Error: No project name specified. Doing nothing..."
      return 1
    fi
    if [[ "${project_name}" == "@current" ]]; then
      echo "Error: A project cannot be called @current."
      return 1
    fi
    if [[ -d "${project_path}" ]]; then
      echo "Error: Folder ${project_path} already exists. Doing nothing..."
      return 1
    fi

    mkdir -p "${project_path}"
    if ((is_python)); then
      cp "${SCIROOPLOT_DATA_DIR}/user/DefinePlots.py" "${project_path}/"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/DefinePlots.py" && rm -f "${project_path}/DefinePlots.py.bak"
      "${SCIROOPLOT_BIN}/srp" "set" "${project_name}" "program" "${project_path}/DefinePlots.py"
      if [[ -n "${SCIROOPLOT_PYTHON_EXECUTABLE:-}" ]]; then
        if [[ ! -x "${SCIROOPLOT_PYTHON_EXECUTABLE}" ]]; then
          if [[ -n "${SCIROOPLOT_SOURCE_DIR:-}" ]]; then
            echo "SciRooPlot's Python path is outdated and requires reinstall..."
            "${SCIROOPLOT_SOURCE_DIR}/scripts/install.sh" --reinstall || return 1
            # shellcheck source=/dev/null
            source "${SCIROOPLOT_ENV}"
          else
            echo "Error: SciRooPlot's recorded Python interpreter is missing. Reinstall SciRooPlot to fix this."
            return 1
          fi
        fi
        if ! ${SCIROOPLOT_PYTHON_EXECUTABLE} "${project_path}/DefinePlots.py"; then
          echo "Error: Failed to run ${project_path}/DefinePlots.py. Fix the errors above and rerun srp init-py."
          return 1
        fi
      else
        echo "Error: SciRooPlot was not compiled with Python bindings."
        return 1
      fi
    else
      cp "${SCIROOPLOT_DATA_DIR}/user/CMakeLists.txt" "${project_path}/"
      cp "${SCIROOPLOT_DATA_DIR}/user/DefinePlots.cpp" "${project_path}/"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/CMakeLists.txt" && rm -f "${project_path}/CMakeLists.txt.bak"
      sed -i.bak "s/PROJECT_NAME/${project_name}/" "${project_path}/DefinePlots.cpp" && rm -f "${project_path}/DefinePlots.cpp.bak"
      mkdir -p "${project_path}/build"
      local curdir
      curdir="$(pwd)"
      cd "${project_path}/build" && cmake -Wno-dev .. >/dev/null 2>&1 && cmake --build . >/dev/null 2>&1 && ./definePlots
      local build_status=${?}
      cd "${curdir}" || return 1
      if ((build_status != 0)); then
        echo "Error: Failed to configure, build, or run the project in ${project_path}/build. Fix the errors and rerun srp init-cpp, or inspect the build manually."
        return 1
      fi
      "${SCIROOPLOT_BIN}/srp" "set" "${project_name}" "program" "${project_path}/build/definePlots"
    fi
    "${SCIROOPLOT_BIN}/srp" "set" "${project_name}" "outdir" "${project_path}/output"
    "${SCIROOPLOT_BIN}/srp" "select" "${project_name}"
    "${SCIROOPLOT_BIN}/srp" "show" "${project_name}"
  else
    local args=("${@}")
    [[ -n "${ZSH_VERSION:-}" ]] && setopt local_options KSH_ARRAYS
    if ((${#args[@]} >= 4)) && [[ "${args[2]}" =~ ^(program|outdir)$ ]] && [[ "${args[3]}" != /* ]]; then
      args[3]="$(pwd)/${args[3]}"
    fi
    if ((${#args[@]} >= 1)) && [[ "${args[0]}" =~ ^(add)$ ]]; then
      if ((${#args[@]} >= 3)) && [[ "${args[2]}" != /* ]]; then
        args[2]="$(pwd)/${args[2]}"
      fi
      if ((${#args[@]} >= 4)) && [[ "${args[3]}" != /* ]]; then
        args[3]="$(pwd)/${args[3]}"
      fi
    fi
    "${SCIROOPLOT_BIN}/srp" "${args[@]}"
  fi
  return 0
}

# enable tab completion only for interactive shells
case "${-}" in
  *i*) ;;
  *) return 0 ;;
esac

_scirooplot_helper() {
  case "${1}" in
    load_plot_lists)
      modes=(show pdf eps svg png gif file data list macro print ps html json xml jpg root)
      main_groups=()
      groups=()

      tabcomp_file="$("${SCIROOPLOT_BIN}/srp" confdir "@current")/tabcomp.csv"
      [[ -f "${tabcomp_file}" ]] || return 1

      local name_in group_in
      while IFS="," read -r name_in group_in; do
        main_groups+=("${group_in%%/*}")
        groups+=("${group_in}")
      done < <(LC_ALL=C sort -t',' -k2,2 -u "${tabcomp_file}")
      ;;
    update_plot_names)
      local group="${2:-}"
      names=()

      local name_in group_in
      while IFS="," read -r name_in group_in; do
        [[ "${group_in}" != "${group}" && "${group_in}" != "${group}/"* ]] && continue
        names+=("${name_in}")
      done < <(grep "^.*,${group}" "${tabcomp_file}")
      ;;
    load_srp_lists)
      general_commands=(info update init-cpp init-py add projects clean reset help color verbosity plotmode matchmode matchcase)
      project_commands=(cd edit stats remove rename select show confdir set unset get)
      project_commands_with_prop=(set unset get)
      properties=(program outdir)
      file_commands=(open print)
      color_settings=(bright dark off)
      verbosity_settings=(debug log info warning error silent)
      plotmodes=(show pdf eps svg png gif file data list macro print ps html json xml jpg root)
      matchmode_settings=(exact contains)
      matchcase_settings=(sensitive insensitive)

      projects=()
      local project_file
      project_file="$("${SCIROOPLOT_BIN}/srp" confdir)/projects.info"
      if [[ -f "${project_file}" ]]; then
        projects=("@current")
        local project
        while read -r project; do
          projects+=("${project}")
        done < <(grep -B1 '{' "${project_file}" | grep -v '{' | grep -v -- '^--$')
      fi
      ;;
    contains)
      local needle="${2:-}"
      shift 2
      local item
      for item in "${@}"; do
        [[ "${item}" == "${needle}" ]] && return 0
      done
      return 1
      ;;
  esac
}

# shellcheck disable=SC2016,SC2154
_plot_completions_zsh() {

  local modes main_groups groups names tabcomp_file
  _scirooplot_helper load_plot_lists || return

  _arguments \
    '1: :->group' \
    '2: :->name' \
    '3: :->mode'

  case "${state}" in
    group)
      if [[ "${words[2]}" == *"/"* ]]; then
        _arguments '1:profiles:(${groups[*]})'
      else
        _arguments '1:profiles:(${main_groups[*]})'
      fi
      ;;
    name)
      _scirooplot_helper update_plot_names "${words[2]}"
      _arguments '2:profiles:(${names[*]})'
      ;;
    mode)
      _arguments '3:profiles:(${modes[*]})'
      ;;
  esac
}

# shellcheck disable=SC2016,SC2154
_srp_completions_zsh() {

  local general_commands project_commands project_commands_with_prop properties
  local file_commands color_settings verbosity_settings plotmodes
  local matchmode_settings matchcase_settings projects
  _scirooplot_helper load_srp_lists

  _arguments \
    '1: :->command' \
    '2: :->project' \
    '3: :->property' \
    '4: :->setting'

  case "${state}" in
    command)
      _arguments '1:profiles:(${general_commands[*]} ${project_commands[*]} ${file_commands[*]})'
      ;;
    project)
      if _scirooplot_helper contains "${words[2]}" "${project_commands[@]}"; then
        _arguments '2:profiles:(${projects[*]})'
      elif _scirooplot_helper contains "${words[2]}" "${file_commands[@]}"; then
        _files -g '*.root'
      elif [[ "${words[2]}" == "color" ]]; then
        _arguments '2:profiles:(${color_settings[*]})'
      elif [[ "${words[2]}" == "verbosity" ]]; then
        _arguments '2:profiles:(${verbosity_settings[*]})'
      elif [[ "${words[2]}" == "plotmode" ]]; then
        _arguments '2:profiles:(${plotmodes[*]})'
      elif [[ "${words[2]}" == "matchmode" ]]; then
        _arguments '2:profiles:(${matchmode_settings[*]})'
      elif [[ "${words[2]}" == "matchcase" ]]; then
        _arguments '2:profiles:(${matchcase_settings[*]})'
      fi
      ;;
    property)
      if _scirooplot_helper contains "${words[2]}" "${project_commands_with_prop[@]}"; then
        _arguments '3:profiles:(${properties[*]})'
      elif [[ "${words[2]}" == init-* ]]; then
        _files -/
      elif [[ "${words[2]}" == "add" ]]; then
        _files -f
      fi
      ;;
    setting)
      if [[ "${words[2]}" == "add" ]]; then
        _files -/
      elif [[ "${words[2]}" == "set" ]]; then
        if [[ "${words[4]}" == "program" ]]; then
          _files -f
        elif [[ "${words[4]}" == "outdir" ]]; then
          _files -/
        fi
      fi
      ;;
  esac
}

# shellcheck disable=SC2207
_plot_completions_bash() {

  local modes main_groups groups names tabcomp_file
  _scirooplot_helper load_plot_lists || return

  case "${COMP_CWORD}" in
    1)
      if [[ "${COMP_WORDS[COMP_CWORD]}" == *"/"* ]]; then
        COMPREPLY=($(compgen -W "${groups[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      else
        COMPREPLY=($(compgen -W "${main_groups[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      fi
      ;;
    2)
      _scirooplot_helper update_plot_names "${COMP_WORDS[COMP_CWORD - 1]}"
      COMPREPLY=($(compgen -W "${names[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      ;;
    3)
      COMPREPLY=($(compgen -W "${modes[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      ;;
  esac
}

# shellcheck disable=SC2207
_srp_completions_bash() {

  local general_commands project_commands project_commands_with_prop properties
  local file_commands color_settings verbosity_settings plotmodes
  local matchmode_settings matchcase_settings projects
  _scirooplot_helper load_srp_lists

  case "${COMP_CWORD}" in
    1)
      COMPREPLY=($(compgen -W "${general_commands[*]} ${project_commands[*]} ${file_commands[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      ;;
    2)
      if _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 1]}" "${project_commands[@]}"; then
        COMPREPLY=($(compgen -W "${projects[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 1]}" "${file_commands[@]}"; then
        local cur="${COMP_WORDS[COMP_CWORD]}"
        local d f
        while IFS= read -r d; do
          COMPREPLY+=("${d}/")
        done < <(compgen -d -- "${cur}")
        while IFS= read -r f; do
          [[ "${f}" == *.root ]] && COMPREPLY+=("${f}")
        done < <(compgen -f -- "${cur}")
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "color" ]]; then
        COMPREPLY=($(compgen -W "${color_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "verbosity" ]]; then
        COMPREPLY=($(compgen -W "${verbosity_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "plotmode" ]]; then
        COMPREPLY=($(compgen -W "${plotmodes[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "matchmode" ]]; then
        COMPREPLY=($(compgen -W "${matchmode_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 1]}" == "matchcase" ]]; then
        COMPREPLY=($(compgen -W "${matchcase_settings[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      else
        COMPREPLY=()
      fi
      ;;
    3)
      if _scirooplot_helper contains "${COMP_WORDS[COMP_CWORD - 2]}" "${project_commands_with_prop[@]}"; then
        COMPREPLY=($(compgen -W "${properties[*]}" -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 2]}" == init-* ]]; then
        COMPREPLY=($(compgen -d -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 2]}" == "add" ]]; then
        COMPREPLY=($(compgen -f -- "${COMP_WORDS[COMP_CWORD]}"))
      else
        COMPREPLY=()
      fi
      ;;
    4)
      if [[ "${COMP_WORDS[COMP_CWORD - 3]}" == "add" ]]; then
        COMPREPLY=($(compgen -d -- "${COMP_WORDS[COMP_CWORD]}"))
      elif [[ "${COMP_WORDS[COMP_CWORD - 3]}" == "set" ]]; then
        case "${COMP_WORDS[COMP_CWORD - 1]}" in
          program)
            COMPREPLY=($(compgen -f -- "${COMP_WORDS[COMP_CWORD]}"))
            ;;
          outdir)
            COMPREPLY=($(compgen -d -- "${COMP_WORDS[COMP_CWORD]}"))
            ;;
        esac
      fi
      ;;
  esac
}

if [[ -n "${ZSH_VERSION:-}" ]]; then
  if ! command -v compinit &>/dev/null; then
    autoload -U compinit compdef && compinit
  fi
  if command -v compdef &>/dev/null; then
    compdef _plot_completions_zsh plot
    compdef _srp_completions_zsh srp
  fi
elif [[ -n "${BASH_VERSION:-}" ]]; then
  if ! shopt -q progcomp; then
    BASH_COMPLETION_PATHS=(
      "/usr/share/bash-completion/bash_completion"
      "/etc/bash_completion"
      "/usr/local/etc/bash_completion"
      "/opt/homebrew/etc/bash_completion"
    )
    for bc in "${BASH_COMPLETION_PATHS[@]}"; do
      if [[ -r "${bc}" ]]; then
        # shellcheck source=/dev/null
        source "${bc}"
        shopt -q progcomp && break
      fi
    done
  fi
  if shopt -q progcomp; then
    complete -F _plot_completions_bash plot
    complete -F _srp_completions_bash srp
  fi
fi
