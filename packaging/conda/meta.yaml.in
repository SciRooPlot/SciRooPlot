{% set name = "scirooplot" %}
{% set version = "@VERSION@" %}
{% set sha256 = "@SHA256@" %}

package:
  name: {{ name }}
  version: {{ version }}

source:
  url: https://github.com/SciRooPlot/SciRooPlot/archive/refs/tags/v{{ version }}.tar.gz
  sha256: {{ sha256 }}

build:
  number: 0
  skip: true  # [win]
  script:
    - cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$PREFIX
    - cmake --build build --parallel
    - cmake --install build

requirements:
  build:
    - cmake
    - make
    - {{ compiler('cxx') }}

  host:
    - root
    - boost
    - fmt
    - pybind11
    - python

  run:
    - root
    - boost
    - fmt
    - python

test:
  commands:
    - srp info

about:
  home: https://github.com/SciRooPlot/SciRooPlot
  summary: A command-line plotting app to manage and visualize scientific data.
  license: GPL-3.0-or-later
  license_file: LICENSE

extra:
  recipe-maintainers:
    - mario-krueger
